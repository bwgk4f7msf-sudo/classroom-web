{
  "name": "classroom-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:web api",
    "dev:web": "vite",
    "api": "node --env-file-if-exists=.env server/app.js",
    "dev:full": "npm run dev",
    "demo:full": "node --env-file-if-exists=.env scripts/demo.js",
    "start": "node --env-file-if-exists=.env server/app.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "element-plus": "^2.14.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "svg-captcha": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "npm-run-all2": "^9.0.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
