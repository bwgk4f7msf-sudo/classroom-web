API_PORT=3001
API_HOST=127.0.0.1
# Keep this stable across restarts. Use at least 32 random characters.
SESSION_SECRET=
# Only used when the first administrator is created (minimum 12 characters).
ADMIN_PASSWORD=
DB_DRIVER=sqlite
# For MySQL deployment:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classroom
DB_USER=classroom
DB_PASSWORD=
# Exact origins for production or LAN debugging, separated by commas. No wildcard.
# Local development also accepts localhost/127.0.0.1/[::1] on different ports.
APP_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3001
COOKIE_SECURE=false
TRUST_PROXY=0
# Required when TRUST_PROXY=1: exact proxy IPs or CIDRs, separated by commas.
# Reverse proxy must overwrite X-Forwarded-For/Proto/Host; do not use 0.0.0.0/0.
TRUSTED_PROXIES=
# Keep keys server-side. Empty configuration disables only face operations.
COMPREFACE_URL=http://127.0.0.1:8000
COMPREFACE_API_KEY=
FACE_THRESHOLD=0.85
